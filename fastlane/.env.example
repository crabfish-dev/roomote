# Loaded automatically by fastlane. Keep this file out of git (fastlane/.env).
ANDROID_PACKAGE_NAME=com.elvi.tvremote
# Gradle project dir relative to repo root ("." for native, "android" for React Native / Flutter)
ANDROID_PROJECT_DIR=.
ANDROID_APP_MODULE=app
# Flavor (optional, e.g. "prod") -> bundleProdRelease
ANDROID_FLAVOR=

# Upload keystore. Convention: ~/.android-dev/secrets/<package>/upload.jks + signing.env
ANDROID_KEYSTORE_FILE=~/.android-dev/secrets/com.elvi.tvremote/upload.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=

# Optional per-app Play key (defaults to ~/.android-dev/secrets/play-service-account.json)
# SUPPLY_JSON_KEY=~/.android-dev/secrets/com.elvi.tvremote/play-service-account.json
